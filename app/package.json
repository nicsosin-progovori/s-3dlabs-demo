{
  "name": "s-3dlabs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:bottle": "node server/start.mjs",
    "start": "node server/start.mjs --production",
    "test:bottle:api": "node --test tests/render-contract.test.mjs",
    "test:bottle:lod": "node --experimental-strip-types --test scripts/bottle-lod.test.mjs scripts/bottle-hq.test.mjs",
    "test:bottle:skins": "node --experimental-strip-types --test scripts/bottle-skins.test.mjs",
    "test:bottle:cameras": "node --experimental-strip-types --test tests/camera-views.test.mjs",
    "test:bottle:scenes": "node --experimental-strip-types --test tests/scene-delivery.test.mjs tests/render-contract.test.mjs",
    "test:bottle:composition": "node --experimental-strip-types --test tests/composition.test.mjs tests/render-contract.test.mjs",
    "models:bottle:skins": "node scripts/separate-bottle-skins.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "share": "node scripts/share-preview.mjs start",
    "share:connect": "node scripts/connect-ngrok.mjs",
    "test:share": "node --test scripts/share-health.test.mjs",
    "share:status": "node scripts/share-preview.mjs status",
    "share:stop": "node scripts/share-preview.mjs stop",
    "check:stack": "node scripts/check-stack.mjs",
    "fixtures": "node scripts/blender.mjs --background --factory-startup --python scripts/create-fixtures.py",
    "models:source": "node scripts/blender.mjs --background --factory-startup --python scripts/prepare-source-products.py",
    "models:bottle": "node scripts/blender.mjs --background --factory-startup --python scripts/prepare-source-products.py -- --product bottle",
    "models:endo": "node scripts/blender.mjs --background --factory-startup --python scripts/prepare-endo-rig.py",
    "models:pillow": "node scripts/blender.mjs --background --factory-startup --python-exit-code 1 --python scripts/prepare-pillow-studio.py",
    "test:source:assets": "node --test scripts/source-assets.test.mjs",
    "test:bottle": "node --experimental-strip-types --test scripts/bottle-focus.test.mjs scripts/bottle-motion.test.mjs",
    "test:bottle:shadows": "node --experimental-strip-types --test scripts/bottle-shadows.test.mjs",
    "test:player": "node --experimental-strip-types --test scripts/material-pipeline.test.mjs scripts/shadow-socket.test.mjs scripts/skin-contract.test.mjs scripts/contracts.test.mjs",
    "test:endo": "node --experimental-strip-types --test scripts/endo-motion.test.mjs",
    "test:pillow": "node --experimental-strip-types --test scripts/pillow-studio.test.mjs",
    "test:pillow:model": "node scripts/blender.mjs --background models/pillow/prepared-v02.blend --python-exit-code 1 --python scripts/pillow-model-qa.py",
    "test:logo:cameras": "node --experimental-strip-types --test scripts/logo-camera.test.mjs",
    "test:camera:motion": "node --experimental-strip-types --test scripts/camera-motion.test.mjs",
    "test:studio:look": "node --experimental-strip-types --test scripts/studio-look.test.mjs",
    "setup:browser": "PLAYWRIGHT_BROWSERS_PATH=.cache/playwright playwright install chromium",
    "test:unit": "node --experimental-strip-types --test scripts/*.test.mjs tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:pair": "node --experimental-strip-types --test scripts/pair-composition.test.mjs",
    "test:bottle:branding": "node --test tests/logo-delivery.test.mjs tests/render-contract.test.mjs"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
