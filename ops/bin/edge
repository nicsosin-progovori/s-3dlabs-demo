#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Полный стек с обратным прокси: web + renderer + proxy. Единый вход — http://127.0.0.1:8080
# (прокси роутит /api/render → renderer, остальное → web). В фоне.
exec docker compose -f "$DIR/../docker/docker-compose.yml" --profile edge up -d --build "$@"
