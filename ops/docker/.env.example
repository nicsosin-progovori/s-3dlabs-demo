# Скопируй в ops/docker/.env и поправь под себя (в git не коммитим).
# Локальный домен виртуалхоста (используется nginx, compose и ops/bin/cert).
DOMAIN=scena.develop
# Порты прокси (смени, если 80/443 заняты другими проектами).
EDGE_PORT=80
EDGE_HTTPS_PORT=443
# CORS allowlist для публичного API (обычно пусто — same-origin).
BOTTLE_ALLOWED_ORIGINS=
# Ограничение памяти процессов (Chromium прожорлив).
RENDERER_NODE_OPTIONS=--max-old-space-size=512
WEB_NODE_OPTIONS=
